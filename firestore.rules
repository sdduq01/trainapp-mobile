rules_version = '2';

// Reglas de la base de datos Firestore `trainapp` (no la default).
// Desplegar con:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // true si quien hace la petición es el entrenador activo (accepted) de uid.
    function isActiveTrainerOf(uid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/trainer_links/$(uid)) &&
        get(/databases/$(database)/documents/trainer_links/$(uid)).data.trainerUid == request.auth.uid &&
        get(/databases/$(database)/documents/trainer_links/$(uid)).data.status == 'accepted';
    }

    // Perfil: el propio usuario. El entrenador activo solo lee (necesita la
    // config de intensidad/calentamiento para registrar la sesión del atleta).
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isActiveTrainerOf(uid);
    }

    // Rutina activa: el propio usuario, o su entrenador activo (accepted)
    match /routines/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isActiveTrainerOf(uid);
    }

    // Macro ciclo activo del usuario ("Forjado por el Hierro"). El entrenador
    // activo lee y avanza el conteo al registrar una sesión del atleta, pero
    // no lo crea ni lo borra.
    match /macrocycles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, update: if isActiveTrainerOf(userId);
    }

    // Catálogo de ejercicios: lectura autenticada; nadie escribe desde la app
    // (lo poblan los scripts admin).
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Ejercicios propios del usuario ("Mis ejercicios")
    match /custom_exercises/{userId}/items/{exerciseId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rutinas personalizadas guardadas del usuario ("Mis rutinas")
    match /custom_routines/{userId}/items/{routineId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sesiones completadas: sessions/{uid}/logs/{sessionId}
    match /sessions/{uid}/logs/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // El entrenador activo lee el historial y puede agregar sesiones que él
      // registró (firmadas con recordedBy), pero no edita ni borra ninguna.
      allow read: if isActiveTrainerOf(uid);
      allow create: if isActiveTrainerOf(uid) &&
        request.resource.data.recordedBy == request.auth.uid;
    }

    // Eventos de progresión semanal. El entrenador activo solo agrega eventos.
    match /progressions/{userId}/logs/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if isActiveTrainerOf(userId);
    }

    // Plantillas de rutinas (catálogo): lectura autenticada; nadie escribe.
    match /routine_templates/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Pesos de referencia (PRs) por ejercicio
    // (el entrenador activo los actualiza al registrar una sesión del atleta).
    match /exercise_prs/{userId}/items/{exerciseId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isActiveTrainerOf(userId);
    }

    // Notas personales por ejercicio (ajustes de máquina, cues). El
    // entrenador activo las ve y edita durante la sesión del atleta.
    match /exercise_notes/{userId}/items/{exerciseId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isActiveTrainerOf(userId);
    }

    // Directorio liviano email->uid para que un entrenador pueda ubicar a un
    // atleta por email. Lectura abierta a cualquier autenticado (necesaria
    // para el where('email','==', x)); el doc solo guarda el email para
    // minimizar la exposición de datos.
    match /user_directory/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Relación entrenador-atleta: un doc por atleta (doc id = athleteUid).
    // "Un solo entrenador activo" surge de que `create` solo es posible si
    // el doc no existe; si ya hay un link, cualquier intento de otro
    // entrenador cae en `update`, permitido solo al propio atleta.
    match /trainer_links/{athleteUid} {
      allow read: if request.auth != null &&
        (request.auth.uid == athleteUid ||
         resource.data.trainerUid == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.trainerUid == request.auth.uid &&
        request.resource.data.athleteUid == athleteUid &&
        request.resource.data.trainerUid != athleteUid &&
        request.resource.data.status == 'pending';

      // El atleta acepta: pending -> accepted, sin cambiar quién es el trainer.
      allow update: if request.auth != null &&
        request.auth.uid == athleteUid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.trainerUid == resource.data.trainerUid;

      // Rechazar/revocar (atleta) o cancelar (entrenador): siempre un delete.
      allow delete: if request.auth != null &&
        (request.auth.uid == athleteUid ||
         request.auth.uid == resource.data.trainerUid);
    }
  }
}
