rules_version = '2';

// Reglas de Firebase Storage (bucket trainapp-prod.firebasestorage.app).
// Desplegar con:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // Logos de gimnasio: gym_logos/{ownerUid}/{archivo}. La ruta va por el uid
    // del dueño porque las reglas de Storage no pueden consultar la base
    // `trainapp` (solo la default); el doc `gyms/{gymId}` de Firestore, que
    // solo el dueño actualiza, decide qué logo se muestra.
    match /gym_logos/{ownerUid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == ownerUid &&
        request.resource.size < 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
